+// 团队边缘的 UDP 在别的端口上动态变化，443/8443 是 TCP HTTP/2 能兜底的。
+const TEAM_V4 = ["162.159.197.1", "162.159.197.2"];
+const TEAM_PORTS = [443, 8443];
+
+// CF 没有 A 记录指向 MASQUE 段，官方域名只能用在 SNI 上。
